# Normalize line endings: repository stores LF; checkout follows the platform.
* text=auto
# Shell scripts stay LF; Windows shell files stay CRLF.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.pdf binary
